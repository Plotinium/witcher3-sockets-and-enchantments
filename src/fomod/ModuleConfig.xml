<?xml version="1.0" encoding="utf-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
	<moduleName>Sockets and Enchantments</moduleName>
	<requiredInstallFiles>
		<folder source="core" destination="" />
	</requiredInstallFiles>
	<installSteps order="Explicit">
		<installStep name="Rune slots">
			<optionalFileGroups order="Explicit">
				<group name="Minimum rune slots (set only here: the game loads item data at startup)" type="SelectExactlyOne">
					<plugins order="Explicit">
						<plugin name="As in the base game">
							<description>Rune slots stay as in the game. Pick this if another mod changes item slots.</description>
							<!--IMAGE:base-->
							<typeDescriptor>
								<type name="Recommended" />
							</typeDescriptor>
						</plugin>
						<plugin name="At least 3">
							<description>Swords and armor with fewer than 3 rune slots get 3. Items with more keep theirs.</description>
							<!--IMAGE:slots3-->
							<files>
								<folder source="slots3" destination="" />
							</files>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="At least 5">
							<description>Swords and armor with fewer than 5 rune slots get 5. Items with more keep theirs.</description>
							<!--IMAGE:slots5-->
							<files>
								<folder source="slots5" destination="" />
							</files>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
	</installSteps>
</config>
